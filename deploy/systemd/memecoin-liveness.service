[Unit]
Description=Memecoin liveness probe: is the desk answering
After=memecoin-shadow.service

[Service]
Type=oneshot
WorkingDirectory=%h/.local/opt/memecoin-shadow
EnvironmentFile=-%h/.config/memecoin-shadow/env
Environment=ALLOW_LIVE_TRADING=
Environment=SOLANA_PRIVATE_KEY=
ExecStart=%h/.local/opt/memecoin-shadow/.venv/bin/python -m ops.supervisor \
    --root %h/.local/opt/memecoin-shadow --fast
# 0 alive, 1 not. Both are successful runs of the probe.
SuccessExitStatus=0 1 2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memecoin-liveness
