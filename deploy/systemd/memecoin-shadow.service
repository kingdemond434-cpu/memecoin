[Unit]
Description=Memecoin shadow desk (DRY RUN, no live capital)
Documentation=file:%h/.local/opt/memecoin-shadow/RUNBOOK.md
After=network-online.target
Wants=network-online.target
OnFailure=memecoin-health-escalate.service
# Not a crash loop. Five failures inside a minute means something restarting
# will not fix, and hammering it buries the reason. These are [Unit]
# directives -- under [Service] systemd silently ignores them, which is the
# same way the health unit's OnFailure was disarmed without anyone noticing.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# 90s measured 62 process kills in 7 days (2026-08-28's own MemoryMax
# post-mortem) and, once that unrelated bug was fixed, 7 MORE kills in the
# following 6 hours alone (2026-08-29) -- all "Failed with result 'watchdog'",
# not an in-process hang. The ping loop that misses its deadline
# (_health_loop in src/main.py) does nothing but sleep(10) and notify; if
# even that starves for 90s, the OS is not scheduling this PROCESS at all,
# which is what a shared box at load average ~4 on 2 vCPUs actually does
# under real contention from other projects' timers. Raised to give that
# real, measured contention room without making a genuine hang undetectable
# for an unreasonable time -- this is DRY_RUN, so a slower kill costs
# continuity, not capital.
# The comment above diagnosed those kills as CPU starvation on a shared box.
# It was not: this unit is Type=notify with WatchdogSec, and until
# src/runtime/sd_notify.py existed the process sent NEITHER the READY=1 that
# ends `activating` NOR the WATCHDOG=1 that this directive requires. systemd
# was killing a process that had never once pinged it, exactly on schedule.
# Both are now sent -- readiness when every loop is scheduled, the ping on its
# own task at a third of this interval -- so the watchdog measures what it was
# meant to measure and 240s is a real hang detector rather than a timer.
WatchdogSec=240s
# Startup extends its own deadline per phase (EXTEND_TIMEOUT_USEC), so a cold
# cache restoring thousands of wallets is not killed for being slow, while a
# phase that stops progressing still fails inside 90s.
TimeoutStartSec=120s
WorkingDirectory=%h/.local/opt/memecoin-shadow
EnvironmentFile=-%h/.config/memecoin-shadow/env

# The two that matter, set AFTER the EnvironmentFile so they cannot be
# overridden by it. A shadow desk that inherits a live acknowledgement from a
# stale env file is a live desk nobody decided to start, and the whole point
# of this unit is that starting it is never that decision.
Environment=ALLOW_LIVE_TRADING=
Environment=SOLANA_PRIVATE_KEY=
Environment=PYTHONUNBUFFERED=1
# Loopback, and the port the runbook and the health checks use. The status
# endpoint serves the desk's whole interior, so it does not go on an
# interface anything else can reach.
Environment=HEALTH_HOST=127.0.0.1
Environment=HEALTH_PORT=18080

ExecStart=%h/.local/opt/memecoin-shadow/.venv/bin/python -m src.main --dry-run

# Restart, because the ledger that proves forward alpha counts decisions and a
# desk that stays down stops counting. RestartSec is short: the evidence it
# accumulates is the scarce thing here, not the CPU.
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/opt/memecoin-shadow/data %h/.local/opt/memecoin-shadow/models
UMask=0077

# A ladder, not a cliff. MemoryMax=4G on a 4 GB host was a ceiling that could
# never be reached: long before the cgroup hit 4 GB the HOST would be out of
# memory and the kernel OOM killer would pick a victim -- possibly this desk,
# possibly something else on the box, and in neither case a decision anyone
# made. It also disabled the in-process governor, whose bands are fractions of
# this number: SHED at 0.85 x 4 GB = 3.4 GB is a threshold the machine dies
# before crossing, so no relief valve could ever fire. The desk's measured
# peak is 549 MB (2026-08-31), so nothing below is a reduction in what it may
# use -- it is 4x headroom over anything ever observed, arranged so each step
# is cheaper than the next:
#
#   ~1.75 GB  governor TRIM   fewer miners, spill census detail. Reversible.
#   ~2.13 GB  governor SHED   flush to disk, loudly. Still reversible.
#    2.25 GB  MemoryHigh      kernel throttles and reclaims. Slow, never kills.
#    2.5  GB  MemoryMax       cgroup kills THIS unit, and Restart=always
#                             brings it back. A decision, not a lottery.
#
# MemoryHigh is the important one: it turns memory pressure into slowness
# instead of death, which is the whole difference between a desk that loses a
# minute and a desk that loses twelve hours of forward evidence.
MemoryHigh=2304M
MemoryMax=2560M
# Cold pages may leave RAM rather than the process being killed for holding
# them. Without a swap allowance the cgroup has no option between "resident"
# and "dead".
MemorySwapMax=1G
# A child hitting the cgroup limit must not take the desk with it.
OOMPolicy=continue
CPUQuota=200%

# Journald provides bounded rotation.  An append-only shadow.log grows without
# limit and eventually stops the very evidence writes this service exists for.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memecoin-shadow

[Install]
WantedBy=default.target
