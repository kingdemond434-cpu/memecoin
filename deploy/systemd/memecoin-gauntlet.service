[Unit]
Description=Score every candidate edge against the statistical gauntlet
After=memecoin-shadow.service

[Service]
Type=oneshot
WorkingDirectory=%h/.local/opt/memecoin-shadow
EnvironmentFile=-%h/.config/memecoin-shadow/env
Environment=ALLOW_LIVE_TRADING=
Environment=SOLANA_PRIVATE_KEY=

# Reads the launch corpus and writes ONE file: data/state/gauntlet.json.
#
# Deliberately not forward_evidence.json. The desk owns that ledger and
# rewrites it whole on every save, so a second writer there either loses this
# verdict or destroys the desk's decision counters depending on which process
# saved last. The desk reads this sidecar before each promotion evaluation.
#
# Exit codes are outcomes, not failures: 3 means the gauntlet ran and no
# mechanism survived, which is the desk's current honest state and must not
# page anyone. 4 means the corpus could not be scored at all.
ExecStart=%h/.local/opt/memecoin-shadow/.venv/bin/python -m tools.run_gauntlet --storage data/launch_episodes --record data/state/gauntlet.json
SuccessExitStatus=0 3 4

NoNewPrivileges=true
PrivateTmp=true
UMask=0077

# Inside the family budget, not beside it. Every memecoin unit shares
# memecoin.slice, so these caps bound this run and the slice bounds the sum --
# which is what stops memecoin work from starving the quant platform on a
# shared 3814 MB box.
Slice=memecoin.slice

# The whole observation set is held resident for the bootstrap -- roughly a
# kilobyte per launch per mechanism, so a thirty-thousand launch corpus across
# six mechanisms sits in the low hundreds of megabytes. Capped tight because
# this is a WEEKLY BATCH job: a run that needs more than this should fail
# visibly on a Sunday night rather than quietly widening the family's
# footprint every week. Raise it on a measurement, never on a guess.
MemoryHigh=400M
MemoryMax=600M
CPUQuota=50%
Nice=19

# Never start on a box that is already tight. A weekly scoreboard is worth
# nothing next to the collector staying alive, and a skip retries next Sunday
# at no cost. Same guard the trainer uses, at this unit's own ceiling.
ExecCondition=%h/.local/opt/memecoin-shadow/.venv/bin/python -m src.runtime.training_guard --min-available-mib 600 --min-minutes-since-last-success 0

# The desk is never the process the kernel takes. A gauntlet run repeats next
# week; a minute of forward evidence cannot be recovered at any price.
OOMScoreAdjust=500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=memecoin-gauntlet
