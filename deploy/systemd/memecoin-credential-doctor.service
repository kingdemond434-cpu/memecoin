[Unit]
Description=Catch a corrupted credential before it fails silently forever
After=memecoin-shadow.service
Documentation=file:%h/.local/opt/memecoin-shadow/RUNBOOK.md

[Service]
# Inside the family memory budget. memecoin.slice caps the SUM of every
# memecoin unit, which is what keeps this work from starving the quant
# platform that shares this box. A unit outside the slice is a unit outside
# the budget, however modest its own caps look.
Slice=memecoin.slice
Type=oneshot
# 1 means "ran fine, found and alerted on a corrupted-looking credential" --
# informational, not a service defect. Learned from memecoin-feed-doctor.service
# on 2026-08-28: without this, every run that finds something shows up in
# `systemctl --user list-units --failed`, which is noise a cross-project
# health sweep could mistake for a real problem.
SuccessExitStatus=1
WorkingDirectory=%h/.local/opt/memecoin-shadow

# No EnvironmentFile: this tool reads the env file itself, by path, because
# its whole job is checking that file's contents rather than trusting what
# systemd already parsed from it.
Environment=ALLOW_LIVE_TRADING=
Environment=SOLANA_PRIVATE_KEY=

# GITHUB_TOKEN held a corrupted PowerShell SSH command for an unknown period
# on 2026-08-29 before a human read the raw value by hand -- the desk's own
# status endpoint reports credential PRESENCE only, by design, so a garbage
# value and a valid one look identical to everything that only asks "is it
# set". This checks SHAPE (plausible length, no embedded shell syntax, a
# matching prefix where one is published), never authenticity, and never
# prints a value it finds -- --alert reuses the desk's one Telegram channel
# and names only which credential looks wrong.
ExecStart=%h/.local/opt/memecoin-shadow/.venv/bin/python -m tools.credential_doctor --alert

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/memecoin-shadow
UMask=0077
MemoryMax=128M
CPUQuota=50%
Nice=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memecoin-credential-doctor
