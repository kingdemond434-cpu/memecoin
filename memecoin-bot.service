[Unit]
Description=Memecoin Quant Desk
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=notify
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

ExecStartPre=-/usr/bin/docker compose -f /opt/memecoin-bot/docker-compose.yml down
ExecStart=/usr/bin/docker compose -f /opt/memecoin-bot/docker-compose.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f /opt/memecoin-bot/docker-compose.yml down -t 30

WorkingDirectory=/opt/memecoin-bot

EnvironmentFile=/opt/memecoin-bot/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=memecoin-bot

LimitNOFILE=65536
LimitNPROC=32768

MemoryLimit=3.8G
CPUQuota=300%

[Install]
WantedBy=multi-user.target