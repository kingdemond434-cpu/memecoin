# ===========================================
# MEMECOIN QUANT DESK - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to version control!

# --- SOLANA WALLET ---
# Base64-encoded 32-byte Ed25519 private key
SOLANA_PRIVATE_KEY=

# --- RPC PROVIDERS ---
# Get from: https://www.alchemy.com/, https://www.infura.io/, https://www.quicknode.com/
ALCHEMY_KEY=
INFURA_KEY=

# Get from: https://helius.xyz/ (required for Yellowstone gRPC + enhanced APIs)
HELIUS_API_KEY=

# Yellowstone gRPC endpoint (Helius provides this)
# Format: https://yellowstone.helius-rpc.com?api-key=YOUR_KEY
YELLOWSTONE_GRPC_URL=

# --- BLOCK EXPLORERS ---
ETHERSCAN_KEY=
BASESCAN_KEY=
ARBISCAN_KEY=
BSCSCAN_KEY=
SOLSCAN_KEY=

# --- SOCIAL INTELLIGENCE ---
# Twitter/X API v2 Bearer Token (Elevated/Enterprise access recommended)
X_BEARER_TOKEN=

# Telegram Bot API (optional, for public channel monitoring)
TELEGRAM_API_KEY=

# --- OPTIONAL: ADDITIONAL RPC ENDPOINTS ---
# QuickNode, Chainstack, etc. for redundancy
# QUICKNODE_SOLANA_URL=
# QUICKNODE_ETH_URL=