# MEMECOIN SHADOW DESK — data credentials only.
# Never place SOLANA_PRIVATE_KEY or ALLOW_LIVE_TRADING in this file.

# Solana data providers
#
# Keyless free endpoints are already in config/chains.yaml (publicnode,
# leorpc, mainnet-beta); the RPC manager learns per-method carve-outs at
# runtime, so together they cover holder structure, wallet history and
# account reads at $0. When those rate-limit under load, each provider
# below hands out a free-tier key for the cost of a signup, and any of
# them slots into the same pool:
#   Helius     https://helius.dev       (this key; quota resets monthly)
#   Shyft      https://shyft.to
#   QuickNode  https://quicknode.com
#   Chainstack https://chainstack.com
#   Syndica    https://syndica.io
#   GetBlock   https://getblock.io
#   dRPC       https://drpc.org
ALCHEMY_KEY=
HELIUS_API_KEY=
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_GRPC_TOKEN=

# Optional market-data quota
JUPITER_API_KEY=

# Optional public research/social sources
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=

# Optional public address used only to produce segregated-profit paper plans.
# The runtime cannot sign or submit sweep transfers.
PROFIT_COLD_WALLET=

# Host-only health port; remains bound to 127.0.0.1.
MEMECOIN_SHADOW_PORT=18080
